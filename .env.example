# ---- Aplicacao ----
# development | production (production exige SECRET_KEY forte)
APP_ENV=development
# Gere uma chave forte:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-gerada-com-o-comando-acima
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Admin NAO nasce por cadastro. Crie o primeiro com:
#   python -m app.cli create-admin <usuario> <email>      (Docker: docker compose exec api ...)
# ADMIN_USERNAMES foi descontinuada e e ignorada.

# Fuso do "dia do usuario" (hoje, janelas de dias, mes do orcamento, datas padrao)
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# Processos da API. Com mais de 1, use REDIS_URL (cache e rate limit compartilhados).
# Atras de proxy reverso, informe o IP/CIDR dele para o rate limit ver o IP real do cliente.
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=127.0.0.1

# Dashboard: manter a sessao ao atualizar a pagina (cookie SameSite=Strict). false = sempre desloga no F5.
REMEMBER_SESSION=true

# Cache de 30s por usuario (0 desliga). Com REDIS_URL usa Redis; sem, usa memoria.
CACHE_TTL_SECONDS=30
# REDIS_URL=redis://localhost:6379/0

# true = cria tabelas na subida (bom p/ dev). Em producao use false + `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# ---- Banco de dados ----
# Local (SQLite):
DATABASE_URL=sqlite:///./dashboard.db
# Postgres local:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dashboard

# Usadas pelo docker-compose (servico "db")
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=dashboard

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
